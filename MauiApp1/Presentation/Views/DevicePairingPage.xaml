<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.Presentation.ViewModels"
             xmlns:lan="clr-namespace:MauiApp1.Application.Lan"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="MauiApp1.Presentation.Views.DevicePairingPage"
             x:DataType="vm:DevicePairingViewModel" Title="Vinculación por red local" BackgroundColor="#F7F9FB">
    <ContentPage.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#008060" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Padding" Value="18,13" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E8EEF5" />
            <Setter Property="TextColor" Value="#0D1B2A" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="18,13" />
        </Style>
        <Style x:Key="Input" TargetType="Entry">
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="#111D31" />
            <Setter Property="PlaceholderColor" Value="#8291A5" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <Grid Padding="16,20">
            <VerticalStackLayout Spacing="18" MaximumWidthRequest="680" HorizontalOptions="Center">
                <Button Text="← Volver" Clicked="OnBackClicked" HorizontalOptions="Start" Style="{StaticResource SecondaryButton}" />
                <VerticalStackLayout Spacing="4">
                    <Label Text="Vincular dispositivo" FontSize="28" FontAttributes="Bold" TextColor="#111D31" />
                    <Label Text="Conecta este equipo con el coordinador de Windows mediante la red local." FontSize="14" TextColor="#61738A" />
                </VerticalStackLayout>
                <Border Padding="20" BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Estado de la vinculación" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                        <Label Text="{Binding LinkStatus}" FontAttributes="Bold" TextColor="#008060" />
                        <Label Text="Conecta ambos dispositivos al Wi-Fi del negocio. El coordinador debe estar instalado y encendido en Windows." FontSize="13" TextColor="#61738A" />
                        <Button Text="Desvincular este dispositivo" Clicked="OnUnlinkClicked" IsVisible="{Binding CanUnlink}" Style="{StaticResource SecondaryButton}" />
                        <Label Text="Al desvincular, se revoca el acceso al coordinador. Los datos locales se conservan." IsVisible="{Binding CanUnlink}" FontSize="13" TextColor="#61738A" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="20" BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 16" IsVisible="{Binding ShowAddressUpdate}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Actualizar dirección del Coordinador" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                        <Label Text="Si cambió la IP de Windows, comprueba su nueva dirección con el certificado ya guardado. No es una nueva vinculación." FontSize="13" TextColor="#61738A" />
                        <Label Text="Nueva dirección HTTPS" FontSize="13" FontAttributes="Bold" TextColor="#52657D" />
                        <Entry Text="{Binding NewCoordinatorAddress}" Placeholder="https://192.168.1.38:5080" Keyboard="Url"
                               IsEnabled="{Binding CanUpdateCoordinatorAddress}" Style="{StaticResource Input}" />
                        <Label Text="Los datos locales y la vinculación se conservan. Al guardar, la sincronización automática existente puede enviar los pendientes." FontSize="13" TextColor="#61738A" />
                        <Button Text="Comprobar nueva dirección" Clicked="OnUpdateCoordinatorAddressClicked"
                                IsEnabled="{Binding CanUpdateCoordinatorAddress}" Style="{StaticResource PrimaryButton}" />
                        <Label Text="{Binding AddressUpdateMessage}" FontSize="14" TextColor="#111D31" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="20" BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 16" IsVisible="{Binding CanDiscover}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Buscar coordinador" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                            <Label Text="Busca el equipo Windows que coordina el negocio en esta red local." FontSize="13" TextColor="#61738A" />
                        </VerticalStackLayout>
                        <Button Text="Buscar coordinador en esta red" Command="{Binding DiscoverCommand}"
                                IsVisible="{Binding CanDiscover}" Style="{StaticResource PrimaryButton}" />
                        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" HorizontalOptions="Center" Color="#008060" />
                        <CollectionView ItemsSource="{Binding DiscoveredCoordinators}" IsVisible="{Binding HasDiscoveredCoordinators}"
                                        SelectionMode="Single" SelectionChanged="OnCoordinatorSelected" HeightRequest="180">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="lan:CoordinatorCandidate">
                                    <Border Margin="0,3" Padding="12" BackgroundColor="#F7F9FB" Stroke="#E3EAF2"
                                            StrokeThickness="1" StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" TextColor="#111D31" />
                                                <Label Text="Coordinador Miscelánea Ari" FontSize="12" TextColor="#61738A" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="›" FontSize="24" TextColor="#61738A" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button Text="Solicitar vínculo seguro" Clicked="OnRequestDiscoveredPairingClicked"
                                IsVisible="{Binding HasSelectedCoordinator}"
                                IsEnabled="{Binding CanRequestDiscoveredPairing}" Style="{StaticResource PrimaryButton}" />
                        <Label Text="Al solicitarlo, el Administrador verá un código de comparación y tendrá que aprobar el vínculo." FontSize="12" TextColor="#61738A" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="20" BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 16"
                        IsVisible="{Binding ShowDiscoveryRequest}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Confirmar vínculo" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                        <Label Text="Compara este código con el que aparece en Windows. Solo continúa si ambos son idénticos." FontSize="13" TextColor="#61738A" />
                        <Label Text="{Binding DiscoveryVerificationCode}" FontSize="32" FontAttributes="Bold" TextColor="#008060" HorizontalTextAlignment="Center" CharacterSpacing="5" />
                        <Label Text="{Binding DiscoveryRequestStatus}" FontSize="14" TextColor="#52657D" HorizontalTextAlignment="Center" />
                        <Label Text="La solicitud vence en tres minutos. El vínculo no inicia sesión ni sincroniza datos hasta que el usuario inicie sesión." FontSize="12" TextColor="#61738A" />
                        <Button Text="Cancelar solicitud" Command="{Binding CancelDiscoveredPairingCommand}"
                                IsEnabled="{Binding CanCancelDiscoveredPairing}" Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="20" BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 16"
                        IsVisible="{Binding CanManageDiscoveredPairings}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Solicitudes de vínculo en esta red" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                            <Label Text="Inicia sesión como Administrador y compara el código que muestra el dispositivo antes de aprobarlo." FontSize="13" TextColor="#61738A" />
                        </VerticalStackLayout>
                        <Entry Placeholder="Usuario Administrador" Text="{Binding UserName}" IsEnabled="{Binding CanEditForm}" Style="{StaticResource Input}" />
                        <Entry Placeholder="Contraseña del Administrador" Text="{Binding Password}" IsPassword="True" IsEnabled="{Binding CanEditForm}" Style="{StaticResource Input}" />
                        <Button Text="Actualizar solicitudes" Command="{Binding RefreshApprovalRequestsCommand}" Style="{StaticResource SecondaryButton}" />
                        <CollectionView ItemsSource="{Binding PendingDiscoveredPairings}" HeightRequest="320">
                            <CollectionView.EmptyView>
                                <Label Text="No hay solicitudes pendientes. Pulsa «Actualizar solicitudes» para consultar." Padding="8" TextColor="#61738A" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="lan:CoordinatorPendingPairing">
                                    <Border Margin="0,4" Padding="12" BackgroundColor="#F7F9FB" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="7">
                                            <Label Text="{Binding DeviceName}" FontAttributes="Bold" TextColor="#111D31" />
                                            <Label Text="{Binding VerificationCode}" FontSize="25" FontAttributes="Bold" CharacterSpacing="4" TextColor="#008060" />
                                            <Label Text="Compara este código con el del dispositivo antes de aprobar." FontSize="12" TextColor="#61738A" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Button Text="Aprobar" Clicked="OnApproveDiscoveredPairingClicked" Style="{StaticResource PrimaryButton}" />
                                                <Button Grid.Column="1" Text="Rechazar" Clicked="OnRejectDiscoveredPairingClicked" Style="{StaticResource SecondaryButton}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                <Border Padding="20" BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Datos del coordinador" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                            <Label Text="Usa la dirección y la huella de seguridad mostradas en Windows." FontSize="13" TextColor="#61738A" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Dirección del coordinador" FontSize="13" FontAttributes="Bold" TextColor="#52657D" />
                            <Entry Placeholder="https://192.168.1.10:5080" Text="{Binding Address}" IsEnabled="{Binding CanEditAddress}" Keyboard="Url" Style="{StaticResource Input}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Código de seguridad (SHA-256)" FontSize="13" FontAttributes="Bold" TextColor="#52657D" />
                            <Entry Placeholder="Huella del certificado de Windows" Text="{Binding Fingerprint}" IsEnabled="{Binding CanEditConnection}" MaxLength="95" Style="{StaticResource Input}" />
                        </VerticalStackLayout>
                        <Button Text="Cargar huella desde archivo" Command="{Binding LoadFingerprintCommand}"
                                IsVisible="{Binding CanLoadFingerprintFromFile}" IsEnabled="{Binding CanEditConnection}"
                                Style="{StaticResource SecondaryButton}" />
                        <Label Text="La huella permite reconocer el equipo autorizado al conectarse." FontSize="13" TextColor="#61738A" />
                        <Label Text="{Binding HostAddressMessage}" IsVisible="{Binding IsWindowsHost}" FontSize="13" TextColor="#52657D" />
                        <Button Text="Confirmar dirección LAN" Command="{Binding ConfirmHostAddressCommand}"
                                IsVisible="{Binding ShowHostAddressConfirmation}" Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="20" BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 16" IsVisible="{Binding CanGenerateCode}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Autorizar otro dispositivo" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                        <Label Text="Confirma las credenciales del Administrador y entrega el código generado al teléfono." FontSize="13" TextColor="#61738A" />
                        <Entry Placeholder="Administrador del coordinador" Text="{Binding UserName}" IsEnabled="{Binding CanEditForm}" Style="{StaticResource Input}" />
                        <Entry Placeholder="Contraseña del Administrador" Text="{Binding Password}" IsPassword="True" IsEnabled="{Binding CanEditForm}" Style="{StaticResource Input}" />
                        <Button Text="Generar código de vinculación" Command="{Binding GenerateCodeCommand}" Style="{StaticResource PrimaryButton}" />
                        <Label Text="{Binding GeneratedCode}" FontSize="20" FontAttributes="Bold" TextColor="#0D1B2A" HorizontalTextAlignment="Center" />
                        <zxing:BarcodeGeneratorView Value="{Binding GeneratedQrPayload}" Format="QrCode" HeightRequest="240" WidthRequest="240" HorizontalOptions="Center" IsVisible="{Binding CanShowGeneratedQr}" />
                        <Label Text="Escanea este QR con el teléfono. Vence junto con el código temporal." IsVisible="{Binding CanShowGeneratedQr}" FontSize="13" TextColor="#61738A" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="20" BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 16" IsVisible="{Binding ShowPairForm}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Vincular este dispositivo" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                        <Button Text="Escanear QR de Windows" Clicked="OnScanQrClicked" IsVisible="{Binding CanScanQr}" Style="{StaticResource SecondaryButton}" />
                        <Entry Placeholder="Código de ocho dígitos" Text="{Binding Code}" Keyboard="Numeric" MaxLength="8" IsEnabled="{Binding CanEditForm}" Style="{StaticResource Input}" />
                        <Button Text="Vincular / reintentar" Command="{Binding PairCommand}" Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Border>
                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" HorizontalOptions="Center" Color="#008060" />
                <Label Text="{Binding Message}" TextColor="#B42318" FontSize="14" />
                <Label Text="Las cuentas y los datos siguen siendo locales hasta completar la sincronización." FontSize="13" TextColor="#61738A" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
