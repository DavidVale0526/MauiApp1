<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             xmlns:products="clr-namespace:MauiApp1.Application.Products;assembly=MauiApp1.Application"
             x:Class="MauiApp1.Presentation.Views.StockConsultationPage"
             x:DataType="viewModels:StockConsultationViewModel"
             Title="Consulta de existencias">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Grid.Column="0" Text="← Volver" Clicked="OnBackClicked"
                    Padding="12,6" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Consulta de existencias" FontSize="26" FontAttributes="Bold"
                   VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="Información guardada localmente. Desliza hacia abajo para volver a consultar."
                   FontSize="12" />
            <Label Text="{Binding ErrorMessage}" TextColor="Firebrick" />
        </VerticalStackLayout>

        <Border Grid.Row="2" Stroke="OrangeRed" Padding="10" IsVisible="{Binding HasLowStockAlert}">
            <Label Text="{Binding LowStockAlertMessage}" TextColor="OrangeRed" />
        </Border>

        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Products}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Todavía no hay productos registrados."
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="products:ProductSummary">
                        <Grid Padding="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                   FontSize="18" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}"
                                   VerticalOptions="Center" />
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CategoryName, StringFormat='Categoría: {0}'}" />
                            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SalePriceText}" />
                            <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding StockText}"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding MinimumStockText}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
