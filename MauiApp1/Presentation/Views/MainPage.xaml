<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             x:Class="MauiApp1.Presentation.Views.MainPage"
             x:DataType="viewModels:MainPageViewModel"
             Title="{Binding Title}">
    <Grid Padding="24">
        <ScrollView>
        <VerticalStackLayout Spacing="16" VerticalOptions="Start" HorizontalOptions="Center">
            <Label Text="{Binding Title}" FontSize="28" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="Sesión iniciada como" FontSize="16" HorizontalTextAlignment="Center" />
            <Label Text="{Binding CurrentUserName}" FontSize="22" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding CurrentRole}" FontSize="16" HorizontalTextAlignment="Center" />
            <Border IsVisible="{Binding HasLowStockAlert}" Stroke="OrangeRed" Padding="12">
                <Label Text="{Binding LowStockAlertMessage}" TextColor="OrangeRed" />
            </Border>
            <Button Text="Administrar categorías" Clicked="OnManageCategoriesClicked" />
            <Button Text="Administrar productos" Clicked="OnManageProductsClicked" />
            <Button Text="Consultar existencias" Clicked="OnConsultStockClicked" />
            <Button Text="Registrar compra" Clicked="OnRegisterPurchaseClicked" />
            <Button Text="Historial de compras" Clicked="OnPurchaseHistoryClicked" />
            <Button Text="Historial de movimientos" Clicked="OnInventoryMovementHistoryClicked" />
            <Button Text="Registrar venta" Clicked="OnRegisterSaleClicked" />
            <Button Text="Historial de ventas" Clicked="OnSaleHistoryClicked" />
            <Button Text="Clientes y crédito" Clicked="OnCustomersClicked" />
            <Button Text="Registrar pagos y consultar saldos" Clicked="OnPaymentsClicked" />
            <Button Text="Reportes" Clicked="OnReportsClicked" />
            <Button Text="Registrar salida de inventario" Clicked="OnRegisterOtherExitClicked" />
            <Button Text="Crear cuenta de Cajero" IsVisible="{Binding IsAdministrator}"
                    Clicked="OnCreateCashierAccountClicked" />
            <Button Text="Cerrar sesión" Command="{Binding SignOutCommand}" />
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
