<?xml version="1.0" encoding="utf-8" ?>
<views:CoordinatorRefreshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiApp1.Presentation.Views"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             x:Class="MauiApp1.Presentation.Views.MainPage"
             x:DataType="viewModels:MainPageViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F9FB">
    <ContentPage.Resources>
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E3EAF2" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="DashboardButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#0D1B2A" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style x:Key="DashboardSecondaryButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#F1F5F9" />
            <Setter Property="TextColor" Value="#26384C" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style x:Key="SidebarButtonStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#1B3047" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </ContentPage.Resources>
    <Grid x:Name="RootLayout"
          ColumnDefinitions="0,*"
          BackgroundColor="#F7F9FB"
          SizeChanged="OnRootLayoutSizeChanged">
        <Border x:Name="Sidebar"
                Grid.Column="0"
                IsVisible="False"
                BackgroundColor="#0D1B2A"
                StrokeThickness="0"
                Padding="22,28">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                        <Image Source="nav_home_sidebar.png" WidthRequest="22" HeightRequest="22"
                               VerticalOptions="Center" Aspect="AspectFit" />
                        <Label Grid.Column="1" Text="Miscelánea Ari" FontSize="20" FontAttributes="Bold"
                               TextColor="White" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="GESTIÓN DEL NEGOCIO" FontSize="10" CharacterSpacing="1" TextColor="#A9B8C9" />
                </VerticalStackLayout>

                <Label Grid.Row="1" Text="MENÚ PRINCIPAL" Margin="0,34,0,12" FontSize="10"
                       FontAttributes="Bold" CharacterSpacing="1" TextColor="#93A4B8" />

                <VerticalStackLayout Grid.Row="2" Spacing="8">
                    <Border Style="{StaticResource SidebarButtonStyle}">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRegisterSaleClicked" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <Image Source="nav_sales_sidebar.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="Punto de venta" FontSize="13" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SidebarButtonStyle}">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnManageProductsClicked" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <Image Source="nav_inventory_sidebar.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="Productos y categorías" FontSize="13" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SidebarButtonStyle}">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnConsultStockClicked" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <Image Source="nav_inventory_sidebar.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="Existencias" FontSize="13" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SidebarButtonStyle}">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRegisterPurchaseClicked" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <Image Source="nav_sales_sidebar.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="Compras" FontSize="13" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SidebarButtonStyle}">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnInventoryMovementHistoryClicked" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <Image Source="nav_inventory_sidebar.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="Movimientos" FontSize="13" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SidebarButtonStyle}">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReportsClicked" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <Image Source="nav_reports_sidebar.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="Reportes" FontSize="13" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="3" Spacing="8">
                    <Border Style="{StaticResource SidebarButtonStyle}">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccountRecoveryClicked" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <Label Text="♙" FontSize="20" TextColor="White" HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Seguridad de la cuenta" FontSize="13" TextColor="White"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SidebarButtonStyle}">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSynchronizationClicked" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <Image Source="nav_more_sidebar.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="Sincronización y conexión" FontSize="13" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SidebarButtonStyle}">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SignOutCommand}" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <Image Source="nav_more_sidebar.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" />
                            <Label Grid.Column="1" Text="Cerrar sesión" FontSize="13" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout x:Name="DashboardContent"
                                 Padding="18,24"
                                 Spacing="22"
                                 HorizontalOptions="Center"
                                 MaximumWidthRequest="1440">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*">
                    <Label Text="Panel principal" FontSize="30" FontAttributes="Bold" TextColor="#111D31" />
                    <Label Grid.Row="1" Text="Resumen y accesos de Miscelánea Ari" FontSize="14" TextColor="#61738A" />
                </Grid>

                <Border BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="18">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Sesión iniciada como" FontSize="13" TextColor="#61738A" />
                        <Label Grid.Row="1" Text="{Binding CurrentUserName}" FontSize="21" FontAttributes="Bold" TextColor="#111D31" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentRole}" FontSize="14"
                               TextColor="#52657D" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border IsVisible="{Binding HasLowStockAlert}"
                        BackgroundColor="#FFF8F3" Stroke="#F0A35E" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Atención: existencias bajas" FontSize="16" FontAttributes="Bold" TextColor="#A3440B" />
                        <Label Text="{Binding LowStockAlertMessage}" FontSize="13" TextColor="#873B13" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#0D1B2A" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="18">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Acceso rápido" FontSize="17" FontAttributes="Bold" TextColor="White" />
                        <Label Grid.Row="1" Text="Continúa con la operación del negocio" FontSize="12" TextColor="#C7D2DF" />
                        <Button Grid.Column="1" Grid.RowSpan="2" Text="Registrar venta  →" Clicked="OnRegisterSaleClicked"
                                BackgroundColor="#FFFFFF" TextColor="#0D1B2A" FontAttributes="Bold"
                                CornerRadius="9" Padding="16,10" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label Text="Operaciones" FontSize="21" FontAttributes="Bold" TextColor="#111D31" />

                <Grid x:Name="MenuCardsGrid" HorizontalOptions="Fill" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                    <Border x:Name="SalesCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Ventas" FontSize="18" FontAttributes="Bold" TextColor="#111D31" />
                            <Label Text="Registra ventas y consulta su historial." FontSize="12" TextColor="#718198" LineBreakMode="WordWrap" />
                            <Button Text="Registrar venta" Clicked="OnRegisterSaleClicked" Style="{StaticResource DashboardButtonStyle}" />
                            <Button Text="Historial de ventas" Clicked="OnSaleHistoryClicked" Style="{StaticResource DashboardSecondaryButtonStyle}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="InventoryCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Catálogo e inventario" FontSize="18" FontAttributes="Bold" TextColor="#111D31" />
                            <Label Text="Administra productos y revisa existencias." FontSize="12" TextColor="#718198" LineBreakMode="WordWrap" />
                            <Button Text="Administrar productos" Clicked="OnManageProductsClicked" Style="{StaticResource DashboardButtonStyle}" />
                            <Button Text="Administrar categorías" Clicked="OnManageCategoriesClicked" Style="{StaticResource DashboardSecondaryButtonStyle}" />
                            <Button Text="Consultar existencias" Clicked="OnConsultStockClicked" Style="{StaticResource DashboardSecondaryButtonStyle}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="PurchasesCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Compras y movimientos" FontSize="18" FontAttributes="Bold" TextColor="#111D31" />
                            <Label Text="Registra entradas y consulta el historial." FontSize="12" TextColor="#718198" LineBreakMode="WordWrap" />
                            <Button Text="Registrar compra" Clicked="OnRegisterPurchaseClicked" Style="{StaticResource DashboardButtonStyle}" />
                            <Button Text="Historial de compras" Clicked="OnPurchaseHistoryClicked" Style="{StaticResource DashboardSecondaryButtonStyle}" />
                            <Button Text="Historial de movimientos" Clicked="OnInventoryMovementHistoryClicked" Style="{StaticResource DashboardSecondaryButtonStyle}" />
                            <Button Text="Registrar salida de inventario" Clicked="OnRegisterOtherExitClicked" Style="{StaticResource DashboardSecondaryButtonStyle}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="OtherCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Clientes y seguimiento" FontSize="18" FontAttributes="Bold" TextColor="#111D31" />
                            <Label Text="Consulta clientes, pagos e información del negocio." FontSize="12" TextColor="#718198" LineBreakMode="WordWrap" />
                            <Button Text="Clientes y crédito" Clicked="OnCustomersClicked" Style="{StaticResource DashboardButtonStyle}" />
                            <Button Text="Registrar pagos y consultar saldos" LineBreakMode="WordWrap" Clicked="OnPaymentsClicked" Style="{StaticResource DashboardSecondaryButtonStyle}" />
                            <Button Text="Reportes" Clicked="OnReportsClicked" Style="{StaticResource DashboardSecondaryButtonStyle}" />
                            <Button Text="Crear cuenta de Cajero" LineBreakMode="WordWrap" IsVisible="{Binding IsAdministrator}"
                                    Clicked="OnCreateCashierAccountClicked" Style="{StaticResource DashboardSecondaryButtonStyle}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid x:Name="BottomActionsGrid" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Sincronización y conexión" Clicked="OnSynchronizationClicked"
                            BackgroundColor="#E8EDF3" TextColor="#26384C" CornerRadius="9" Padding="14,12" />
                    <Button Grid.Column="1" Text="Cerrar sesión" Command="{Binding SignOutCommand}"
                            BackgroundColor="#E8EDF3" TextColor="#26384C" CornerRadius="9" Padding="14,12" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:CoordinatorRefreshPage>
