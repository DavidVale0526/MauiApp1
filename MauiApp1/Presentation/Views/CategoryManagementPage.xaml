<?xml version="1.0" encoding="utf-8" ?>
<views:CoordinatorRefreshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiApp1.Presentation.Views"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             xmlns:categories="clr-namespace:MauiApp1.Application.Categories;assembly=MauiApp1.Application"
             x:Class="MauiApp1.Presentation.Views.CategoryManagementPage"
             x:DataType="viewModels:CategoryManagementViewModel"
             Title="Categorías"
             BackgroundColor="#F7F9FB">
    <Grid x:Name="PageLayout" Padding="20" RowDefinitions="Auto,*" RowSpacing="20" SizeChanged="OnPageSizeChanged">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Button Text="← Volver" Clicked="OnCloseClicked"
                    BackgroundColor="#E8EEF5" TextColor="#0D1B2A"
                    CornerRadius="12" Padding="18,12" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                <Label Text="Categorías" FontSize="28" FontAttributes="Bold" TextColor="#111D31" />
                <Label Text="Organiza los productos por categoría" FontSize="14" TextColor="#61738A" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1" x:Name="ContentLayout" ColumnDefinitions="*" RowDefinitions="Auto,*" RowSpacing="18">
            <Border x:Name="FormCard" Grid.Row="0" Padding="20" BackgroundColor="White"
                    Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Nueva categoría" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                        <Label Text="Escribe el nombre que aparecerá en el catálogo." FontSize="13" TextColor="#61738A" />
                    </VerticalStackLayout>
                    <Grid x:Name="FormFields" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <Entry x:Name="CategoryNameEntry" Grid.Row="0" Placeholder="Nombre de la categoría"
                               Text="{Binding CategoryName}" ReturnType="Go" ClearButtonVisibility="WhileEditing"
                               BackgroundColor="#FFFFFF" TextColor="#111D31" PlaceholderColor="#8291A5"
                               HeightRequest="54" />
                        <HorizontalStackLayout x:Name="FormActions" Grid.Row="1" Spacing="10">
                            <Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
                                    BackgroundColor="#0D1B2A" TextColor="White" CornerRadius="11"
                                    Padding="22,12" />
                            <Button Text="Cancelar" Command="{Binding CancelEditCommand}"
                                    IsVisible="{Binding IsEditing}" BackgroundColor="#E8EEF5"
                                    TextColor="#0D1B2A" CornerRadius="11" Padding="20,12" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Label Text="El nombre es obligatorio y único. Se ignoran mayúsculas y espacios al comparar."
                           FontSize="12" TextColor="#61738A" />
                    <Label Text="{Binding ErrorMessage}" TextColor="#B42318" FontSize="13" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Start" Color="#0D1B2A" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="1" Spacing="12">
                <Label Text="Categorías registradas" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Border Padding="20" BackgroundColor="White" Stroke="#E3EAF2" StrokeShape="RoundRectangle 14">
                            <Label Text="Todavía no hay categorías. Escribe un nombre para crear la primera."
                                   HorizontalTextAlignment="Center" TextColor="#61738A" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="categories:CategorySummary">
                            <Border Margin="0,0,0,10" Padding="16" BackgroundColor="White"
                                    Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                <Grid x:Name="CategoryRow" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="10">
                                    <Label Text="{Binding Name}" FontSize="16"
                                           TextColor="#111D31" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Editar" Clicked="OnEditClicked"
                                            BackgroundColor="#E8EEF5" TextColor="#0D1B2A"
                                            CornerRadius="10" Padding="16,9" />
                                    <Button Grid.Column="2" Text="Eliminar" Clicked="OnDeleteClicked"
                                            BackgroundColor="#FDECEC" TextColor="#B42318"
                                            CornerRadius="10" Padding="16,9" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</views:CoordinatorRefreshPage>
