<?xml version="1.0" encoding="utf-8" ?>
<views:CoordinatorRefreshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiApp1.Presentation.Views"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             xmlns:products="clr-namespace:MauiApp1.Application.Products;assembly=MauiApp1.Application"
             x:Class="MauiApp1.Presentation.Views.ProductManagementPage"
             x:DataType="viewModels:ProductManagementViewModel"
             Title="Productos"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F9FB">
    <ContentPage.Resources>
        <Style x:Key="ProductSurfaceStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E3EAF2" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="ProductPrimaryButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#0D1B2A" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="16,11" />
        </Style>
        <Style x:Key="ProductSecondaryButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#EEF2F7" />
            <Setter Property="TextColor" Value="#26384C" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="13,8" />
        </Style>
        <Style x:Key="ProductFieldBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#DCE5EF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 9" />
            <Setter Property="Padding" Value="12,1" />
        </Style>
    </ContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout x:Name="PageContent" SizeChanged="OnPageContentSizeChanged"
                             Padding="18,22" Spacing="18" HorizontalOptions="Center" MaximumWidthRequest="1440">
            <VerticalStackLayout Spacing="12">
                <Button Text="← Volver" Clicked="OnBackClicked" HorizontalOptions="Start"
                        Style="{StaticResource ProductSecondaryButtonStyle}" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Text="Catálogo de productos" FontSize="29" FontAttributes="Bold" TextColor="#111D31" />
                    <Label Grid.Row="1" Text="Administra productos, categorías y niveles de existencia." FontSize="14" TextColor="#61738A" />
                    <Border Grid.Column="1" Grid.RowSpan="2" BackgroundColor="#EAF0F7" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20" Padding="12,6" VerticalOptions="Center">
                        <Label Text="CATÁLOGO" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5" TextColor="#52657D" />
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <Border Style="{StaticResource ProductSurfaceStyle}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding SaveButtonText}" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                        <Label Text="La existencia inicial es cero; se actualiza mediante entradas de inventario." FontSize="12" TextColor="#718198" />
                    </VerticalStackLayout>

                    <Grid x:Name="ProductFormGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                        <VerticalStackLayout x:Name="NameField" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5">
                            <Label Text="NOMBRE DEL PRODUCTO" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5" TextColor="#61738A" />
                            <Border Style="{StaticResource ProductFieldBorderStyle}" HeightRequest="48">
                                <Entry Placeholder="Nombre del producto" Text="{Binding Name}" ReturnType="Next"
                                       TextColor="#172438" PlaceholderColor="#9AA9BA" HorizontalTextAlignment="Start" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="PriceField" Grid.Row="1" Grid.Column="0" Spacing="5">
                            <Label Text="PRECIO DE VENTA" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5" TextColor="#61738A" />
                            <Border Style="{StaticResource ProductFieldBorderStyle}" HeightRequest="48">
                                <Entry Placeholder="0.00" Text="{Binding SalePrice}" Keyboard="Numeric" ReturnType="Next"
                                       TextColor="#172438" PlaceholderColor="#9AA9BA" HorizontalTextAlignment="Start" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="UnitField" Grid.Row="1" Grid.Column="1" Spacing="5">
                            <Label Text="UNIDAD" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5" TextColor="#61738A" />
                            <Border Style="{StaticResource ProductFieldBorderStyle}" HeightRequest="48">
                                <Entry Placeholder="pieza, kg, litro…" Text="{Binding Unit}" ReturnType="Next"
                                       TextColor="#172438" PlaceholderColor="#9AA9BA" HorizontalTextAlignment="Start" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="CategoryField" Grid.Row="2" Grid.Column="0" Spacing="5">
                            <Label Text="CATEGORÍA" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5" TextColor="#61738A" />
                            <Border Style="{StaticResource ProductFieldBorderStyle}">
                                <Picker Title="Selecciona una categoría" ItemsSource="{Binding Categories}"
                                        SelectedItem="{Binding SelectedCategory}" ItemDisplayBinding="{Binding Name}"
                                        TextColor="#172438" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="MinimumStockField" Grid.Row="2" Grid.Column="1" Spacing="5">
                            <Label Text="EXISTENCIA MÍNIMA" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5" TextColor="#61738A" />
                            <Border Style="{StaticResource ProductFieldBorderStyle}" HeightRequest="48">
                                <Entry Placeholder="Ej.: 0 o 0.5" Text="{Binding MinimumStock}" Keyboard="Numeric" ReturnType="Done"
                                       TextColor="#172438" PlaceholderColor="#9AA9BA" HorizontalTextAlignment="Start" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding ErrorMessage}" TextColor="#B42318" FontSize="13" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0D1B2A" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
                                HorizontalOptions="Fill" Style="{StaticResource ProductPrimaryButtonStyle}" />
                        <Button Grid.Column="1" Text="Cancelar" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}"
                                Style="{StaticResource ProductSecondaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Productos registrados" FontSize="21" FontAttributes="Bold" TextColor="#111D31" />
                    <Label Text="Consulta su estado, precio y existencias." FontSize="12" TextColor="#718198" />
                </VerticalStackLayout>
            </Grid>

            <CollectionView x:Name="ProductsCollection" ItemsSource="{Binding Products}" SelectionMode="None" HeightRequest="560">
                <CollectionView.EmptyView>
                    <Border BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20">
                        <Label Text="Todavía no hay productos registrados." TextColor="#61738A"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="products:ProductSummary">
                        <Border BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1"
                                StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="7">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="16"
                                       FontAttributes="Bold" TextColor="#111D31" VerticalOptions="Center" />
                                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#EEF2F7" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16" Padding="10,4" VerticalOptions="Center">
                                    <Label Text="{Binding StatusText}" FontSize="11" FontAttributes="Bold" TextColor="#52657D" />
                                </Border>
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CategoryName, StringFormat='Categoría: {0}'}"
                                       FontSize="12" TextColor="#52657D" />
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="PRECIO" FontSize="9" FontAttributes="Bold" TextColor="#8795A7" />
                                        <Label Text="{Binding SalePriceText}" FontSize="13" TextColor="#26384C" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="EXISTENCIA" FontSize="9" FontAttributes="Bold" TextColor="#8795A7" />
                                        <Label Text="{Binding StockText}" FontSize="13" FontAttributes="Bold" TextColor="#26384C" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding MinimumStockText}" FontSize="11" TextColor="#718198" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Editar" Clicked="OnEditClicked"
                                            Style="{StaticResource ProductSecondaryButtonStyle}" FontSize="12" Padding="12,7" />
                                    <Button Grid.Column="2" Text="{Binding ActionText}" Clicked="OnChangeStatusClicked"
                                            Style="{StaticResource ProductSecondaryButtonStyle}" FontSize="12" Padding="12,7" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</views:CoordinatorRefreshPage>
