<?xml version="1.0" encoding="utf-8" ?>
<views:CoordinatorRefreshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiApp1.Presentation.Views"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             xmlns:products="clr-namespace:MauiApp1.Application.Products;assembly=MauiApp1.Application"
             x:Class="MauiApp1.Presentation.Views.ProductManagementPage"
             x:DataType="viewModels:ProductManagementViewModel"
             Title="Productos">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Grid.Column="0" Text="← Volver" Clicked="OnBackClicked"
                    Padding="12,6" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Productos" FontSize="26" FontAttributes="Bold"
                   VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Entry Placeholder="Nombre del producto" Text="{Binding Name}" ReturnType="Next" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Precio de venta" Text="{Binding SalePrice}"
                       Keyboard="Numeric" ReturnType="Next" />
                <Entry Grid.Column="1" Placeholder="Unidad (pieza, kg, litro…)" Text="{Binding Unit}"
                       ReturnType="Next" />
            </Grid>
            <Picker Title="Categoría" ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}"
                    ItemDisplayBinding="{Binding Name}" />
            <Entry Placeholder="Nivel mínimo de existencia" Text="{Binding MinimumStock}"
                   Keyboard="Numeric" ReturnType="Done" />
            <Label Text="La existencia inicia en cero y se modifica mediante entradas de inventario."
                   FontSize="12" />
            <Label Text="{Binding ErrorMessage}" TextColor="Firebrick" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
                        HorizontalOptions="Fill" />
                <Button Text="Cancelar edición" Command="{Binding CancelEditCommand}"
                        IsVisible="{Binding IsEditing}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Products}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Todavía no hay productos registrados."
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="products:ProductSummary">
                    <Grid Padding="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                               FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}"
                               VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding CategoryName, StringFormat='Categoría: {0}'}" />
                        <Label Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding SalePriceText}" />
                        <Label Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding StockText}" />
                        <Label Grid.Row="4" Grid.ColumnSpan="3" Text="{Binding MinimumStockText}" />
                        <Button Grid.Row="5" Grid.Column="1" Text="Editar" Clicked="OnEditClicked"
                                Padding="12,6" />
                        <Button Grid.Row="5" Grid.Column="2" Text="{Binding ActionText}"
                                Clicked="OnChangeStatusClicked" Padding="12,6" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</views:CoordinatorRefreshPage>
