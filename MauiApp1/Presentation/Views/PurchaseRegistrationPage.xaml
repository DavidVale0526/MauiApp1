<?xml version="1.0" encoding="utf-8" ?>
<views:CoordinatorRefreshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiApp1.Presentation.Views"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             x:Class="MauiApp1.Presentation.Views.PurchaseRegistrationPage"
             x:DataType="viewModels:PurchaseRegistrationViewModel"
             Title="Registrar compra">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Button Text="← Volver" HorizontalOptions="Start" Clicked="OnBackClicked" />
            <Label Text="Registrar compra" FontSize="28" FontAttributes="Bold" />
            <Label Text="Selecciona productos y cantidades recibidas. Los productos repetidos se acumulan en un renglón." />

            <Picker Title="Producto activo"
                    ItemsSource="{Binding Products}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedItem="{Binding SelectedProduct}"
                    IsEnabled="{Binding CanEditLines}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Entry Grid.Column="0" Placeholder="Cantidad recibida" Keyboard="Numeric"
                       Text="{Binding QuantityInput}" IsEnabled="{Binding CanEditLines}" />
                <Button Grid.Column="1" Text="Agregar" Command="{Binding AddLineCommand}" />
            </Grid>

            <Label Text="Resumen de la compra" FontSize="20" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Lines}" HeightRequest="260">
                <CollectionView.EmptyView>
                    <Label Text="Aún no hay productos en la compra." Padding="8" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PurchaseCartLine">
                        <Grid Padding="8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding QuantityText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Quitar" Clicked="OnRemoveLineClicked"
                                    IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEditLines}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
            <Button Text="Revisar y confirmar compra" Clicked="OnReviewClicked" IsEnabled="{Binding CanEditLines}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</views:CoordinatorRefreshPage>
