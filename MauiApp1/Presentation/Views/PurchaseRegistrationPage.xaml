<?xml version="1.0" encoding="utf-8" ?>
<views:CoordinatorRefreshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiApp1.Presentation.Views"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             x:Class="MauiApp1.Presentation.Views.PurchaseRegistrationPage"
             x:DataType="viewModels:PurchaseRegistrationViewModel"
             Title="Registrar compra" BackgroundColor="#F7F9FB">
    <ScrollView>
        <Grid x:Name="PageLayout" Padding="16,20" SizeChanged="OnPageSizeChanged">
            <Grid x:Name="ContentLayout" MaximumWidthRequest="1180" HorizontalOptions="Center"
                  ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="16">
                <Grid x:Name="HeaderArea" Grid.Row="0" Grid.ColumnSpan="1" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Button Text="← Volver" Clicked="OnBackClicked" BackgroundColor="#E8EEF5"
                            TextColor="#0D1B2A" CornerRadius="12" Padding="18,12" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="Registrar compra" FontSize="28" FontAttributes="Bold" TextColor="#111D31" />
                        <Label Text="Agrega las cantidades recibidas para actualizar las existencias."
                               FontSize="14" TextColor="#61738A" />
                    </VerticalStackLayout>
                </Grid>

                <Border x:Name="AddProductCard" Grid.Row="1" Grid.Column="0" Padding="20"
                        BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Agregar productos" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                            <Label Text="Los productos repetidos se acumulan en un solo renglón."
                                   FontSize="13" TextColor="#61738A" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Producto" FontSize="13" FontAttributes="Bold" TextColor="#52657D" />
                            <Picker Title="Selecciona un producto activo" ItemsSource="{Binding Products}"
                                    ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedProduct}"
                                    IsEnabled="{Binding CanEditLines}" TextColor="#111D31" />
                        </VerticalStackLayout>
                        <Grid x:Name="QuantityControls" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="Cantidad recibida" FontSize="13" FontAttributes="Bold" TextColor="#52657D" />
                                <Entry Placeholder="Ej. 5.000" Keyboard="Numeric" Text="{Binding QuantityInput}"
                                       IsEnabled="{Binding CanEditLines}" HeightRequest="52"
                                       BackgroundColor="White" TextColor="#111D31" PlaceholderColor="#8291A5" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Agregar" Command="{Binding AddLineCommand}"
                                    IsEnabled="{Binding CanEditLines}" BackgroundColor="#0D1B2A"
                                    TextColor="White" CornerRadius="11" Padding="20,12" VerticalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="PurchaseSummaryCard" Grid.Row="2" Grid.Column="0" Padding="20"
                        BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Resumen de la compra" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                                <Label Text="Revisa los productos y cantidades antes de confirmar."
                                       FontSize="13" TextColor="#61738A" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <CollectionView ItemsSource="{Binding Lines}" HeightRequest="260" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Border Padding="18" BackgroundColor="#F7F9FB" Stroke="#E3EAF2"
                                        StrokeShape="RoundRectangle 12">
                                    <Label Text="Aún no hay productos en la compra."
                                           HorizontalTextAlignment="Center" TextColor="#61738A" />
                                </Border>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:PurchaseCartLine">
                                    <Border Margin="0,0,0,8" Padding="12" BackgroundColor="#F7F9FB"
                                            Stroke="#E3EAF2" StrokeShape="RoundRectangle 12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="#111D31" />
                                                <Label Text="{Binding QuantityText}" FontSize="13" TextColor="#61738A" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="Quitar" Clicked="OnRemoveLineClicked"
                                                    IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEditLines}"
                                                    BackgroundColor="#FDECEC" TextColor="#B42318"
                                                    CornerRadius="9" Padding="14,8" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button Text="Revisar y confirmar compra" Clicked="OnReviewClicked"
                                IsEnabled="{Binding CanEditLines}" BackgroundColor="#0D1B2A"
                                TextColor="White" CornerRadius="11" Padding="18,13" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="FeedbackArea" Grid.Row="3" Grid.ColumnSpan="1" Spacing="8">
                    <Label Text="{Binding ErrorMessage}" TextColor="#B42318" FontSize="14" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center" Color="#0D1B2A" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </ScrollView>
</views:CoordinatorRefreshPage>
