<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             x:Class="MauiApp1.Presentation.Views.SaleTicketPage"
             x:DataType="viewModels:SaleTicketViewModel"
             Title="Ticket interno"
             BackgroundColor="#F7F9FB">
    <ScrollView>
        <Grid Padding="16,20" SizeChanged="OnPageSizeChanged">
            <VerticalStackLayout x:Name="TicketLayout" Spacing="18" MaximumWidthRequest="620"
                                 HorizontalOptions="Center">
                <Button Text="← Volver" HorizontalOptions="Start" Clicked="OnBackClicked"
                        BackgroundColor="#E8EEF5" TextColor="#0D1B2A"
                        CornerRadius="12" Padding="18,12" />

                <Border Padding="0" BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="0">
                        <VerticalStackLayout Padding="24,26,24,20" Spacing="10" HorizontalOptions="Fill">
                            <Border Padding="12,6" BackgroundColor="#E8EEF5" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20" HorizontalOptions="Center">
                                <Label Text="COMPROBANTE INTERNO" FontSize="11" FontAttributes="Bold"
                                       TextColor="#34445A" />
                            </Border>
                            <Label Text="{Binding StoreName}" FontSize="26" FontAttributes="Bold"
                                   TextColor="#111D31" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding DocumentType}" FontSize="15" FontAttributes="Bold"
                                   TextColor="#34445A" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding ReferenceText}" FontSize="13" TextColor="#61738A"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding DateText}" FontSize="14" TextColor="#34445A"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding ActorText}" FontSize="13" TextColor="#61738A"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding CurrencyText}" FontSize="13" TextColor="#61738A"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding CreditDetailsText}" FontSize="13" TextColor="#34445A"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#E3EAF2" />

                        <VerticalStackLayout Padding="22,18" Spacing="14">
                            <Label Text="Detalle de productos" FontSize="16" FontAttributes="Bold" TextColor="#111D31" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:SaleTicketLine">
                                        <Grid Padding="0,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="{Binding NameText}" FontSize="14" FontAttributes="Bold"
                                                       TextColor="#111D31" />
                                                <Label Text="{Binding QuantityAndUnitText}" FontSize="13" TextColor="#61738A" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding LineTotalText}" FontSize="14"
                                                   FontAttributes="Bold" TextColor="#111D31"
                                                   VerticalOptions="Center" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="#E3EAF2" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Text="TOTAL" FontSize="18" FontAttributes="Bold" TextColor="#111D31" />
                                <Label Grid.Column="1" Text="{Binding TotalText}" FontSize="20"
                                       FontAttributes="Bold" TextColor="#0D1B2A" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Padding="18,14" Spacing="4" BackgroundColor="#F7F9FB">
                            <Label Text="Documento interno de consulta. No es factura ni comprobante fiscal."
                                   FontSize="12" TextColor="#61738A" HorizontalTextAlignment="Center" />
                            <Label Text="Este registro no contiene impuestos ni datos de cobro."
                                   FontSize="12" TextColor="#61738A" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
