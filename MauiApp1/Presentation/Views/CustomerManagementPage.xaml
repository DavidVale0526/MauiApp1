<?xml version="1.0" encoding="utf-8" ?>
<views:CoordinatorRefreshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiApp1.Presentation.Views"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             x:Class="MauiApp1.Presentation.Views.CustomerManagementPage"
             x:DataType="viewModels:CustomerManagementViewModel"
             Title="Clientes y crédito">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Button Text="← Volver" HorizontalOptions="Start" Clicked="OnBackClicked" />
            <Label Text="Clientes" FontSize="28" FontAttributes="Bold" />
            <Entry Placeholder="Nombre del cliente (obligatorio)" Text="{Binding Name}" MaxLength="120" />
            <Entry Placeholder="Teléfono (opcional)" Text="{Binding Phone}" MaxLength="40" Keyboard="Telephone" />
            <Button Text="Guardar cliente" Command="{Binding SaveCommand}" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
            <Label Text="Clientes registrados y saldo de crédito" FontSize="20" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Customers}" HeightRequest="360">
                <CollectionView.EmptyView><Label Text="Aún no hay clientes registrados." Padding="8" /></CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:CustomerListItem">
                        <Border Padding="12" Margin="0,4">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17" />
                                <Label Text="{Binding ContactText}" />
                                <Label Text="{Binding DebtText}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</views:CoordinatorRefreshPage>
