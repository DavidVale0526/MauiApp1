<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             x:Class="MauiApp1.Presentation.Views.CashierSetupPage"
             x:DataType="viewModels:CashierSetupViewModel"
             Title="Crear cuenta de Cajero">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="440"
                             HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="Crear cuenta de Cajero" FontSize="24" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="La cuenta se guardará en este dispositivo. Configúrala también en otros equipos hasta que se habilite la sincronización LAN."
                   FontSize="13" HorizontalTextAlignment="Center" />
            <Entry Placeholder="Nombre de usuario" Text="{Binding UserName}" ReturnType="Next" />
            <Entry Placeholder="Contraseña (mínimo 15 caracteres)" Text="{Binding Password}"
                   IsPassword="True" ReturnType="Next" />
            <Entry Placeholder="Confirma la contraseña" Text="{Binding PasswordConfirmation}"
                   IsPassword="True" ReturnType="Go" />
            <Label Text="{Binding ErrorMessage}" TextColor="Firebrick" />
            <Button Text="Crear cuenta" Command="{Binding CreateAccountCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
