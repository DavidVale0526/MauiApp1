<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MauiApp1.Presentation.ViewModels"
             x:Class="MauiApp1.Presentation.Views.CashierSetupPage"
             x:DataType="viewModels:CashierSetupViewModel"
             Title="Cajeros" BackgroundColor="#F7F9FB">
    <ContentPage.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#0D1B2A" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Padding" Value="18,13" />
        </Style>
        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E8EEF5" />
            <Setter Property="TextColor" Value="#0D1B2A" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,12" />
        </Style>
        <Style x:Key="Input" TargetType="Entry">
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="#111D31" />
            <Setter Property="PlaceholderColor" Value="#8291A5" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <Grid Padding="16,20">
            <VerticalStackLayout Spacing="18" MaximumWidthRequest="680" HorizontalOptions="Center">
                <Button Text="← Volver" Clicked="OnBackClicked" HorizontalOptions="Start" Style="{StaticResource BackButton}" />
                <VerticalStackLayout Spacing="4">
                    <Label Text="Cuentas de cajero" FontSize="28" FontAttributes="Bold" TextColor="#111D31" />
                    <Label Text="Crea accesos y consulta quiénes pueden operar el punto de venta." FontSize="14" TextColor="#61738A" />
                </VerticalStackLayout>
                <Border Padding="20" BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Datos de acceso" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                            <Label Text="Aquí aparecen las cuentas de la base activa; los equipos vinculados consultan el registro del coordinador." FontSize="13" TextColor="#61738A" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Nombre de usuario" FontSize="13" FontAttributes="Bold" TextColor="#52657D" />
                            <Entry Placeholder="Nombre de usuario" Text="{Binding UserName}" ReturnType="Next" Style="{StaticResource Input}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Contraseña" FontSize="13" FontAttributes="Bold" TextColor="#52657D" />
                            <Entry Placeholder="Mínimo 5 caracteres" Text="{Binding Password}" IsPassword="True" ReturnType="Next" Style="{StaticResource Input}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Confirmar contraseña" FontSize="13" FontAttributes="Bold" TextColor="#52657D" />
                            <Entry Placeholder="Repite la contraseña" Text="{Binding PasswordConfirmation}" IsPassword="True" ReturnType="Go" Style="{StaticResource Input}" />
                        </VerticalStackLayout>
                        <Label Text="{Binding ErrorMessage}" TextColor="#B42318" FontSize="14" />
                        <Label Text="{Binding SuccessMessage}" TextColor="#008060" FontSize="14" FontAttributes="Bold" />
                        <Border IsVisible="{Binding HasRecoveryCode}" Padding="14" BackgroundColor="#E8FBF2"
                                Stroke="#A7EACD" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Código de recuperación del cajero" FontSize="15" FontAttributes="Bold" TextColor="#006B50" />
                                <Label Text="{Binding RecoveryCode}" FontSize="20" FontAttributes="Bold" TextColor="#111D31"
                                       FontFamily="monospace" CharacterSpacing="1" />
                                <Label Text="Se muestra una sola vez. Entrégaselo al cajero; podrá usarlo si olvida su contraseña."
                                       FontSize="13" TextColor="#52657D" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Text="Copiar código" Command="{Binding CopyRecoveryCodeCommand}"
                                            BackgroundColor="#008060" TextColor="White" CornerRadius="9" />
                                    <Button Grid.Column="1" Text="Ya lo guardé" Command="{Binding DismissRecoveryCodeCommand}"
                                            BackgroundColor="#E8EEF5" TextColor="#111D31" CornerRadius="9" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                        <Button Text="Crear cuenta" Command="{Binding CreateAccountCommand}" Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="20" BackgroundColor="White" Stroke="#E3EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Cajeros registrados" FontSize="19" FontAttributes="Bold" TextColor="#111D31" />
                                <Label Text="{Binding CashierCountText}" FontSize="13" TextColor="#61738A" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Actualizar" Command="{Binding RefreshCashiersCommand}"
                                    Style="{StaticResource BackButton}" Padding="12,9" />
                        </Grid>
                        <Label Text="{Binding ListErrorMessage}" IsVisible="{Binding HasListError}"
                               TextColor="#B42318" FontSize="14" />
                        <Label Text="Todavía no hay cuentas de cajero registradas." IsVisible="{Binding ShowEmptyMessage}"
                               TextColor="#61738A" FontSize="14" Padding="4,8" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cashiers}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:CashierAccountRow">
                                    <Border Padding="14" BackgroundColor="#F7F9FB" Stroke="#E3EAF2" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
                                            <Label Text="{Binding UserName}" FontSize="16" FontAttributes="Bold" TextColor="#111D31"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1" Text="{Binding StatusText}" TextColor="{Binding StatusTextColor}"
                                                   FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Row="1" Text="{Binding CreatedAtDescription}" FontSize="13" TextColor="#61738A" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                           HorizontalOptions="Center" Color="#008060" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
